# Environment: dev | test | prod
FLASK_ENV=dev

# Generate a real one for production (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Defaults to sqlite:///study.db — point at PostgreSQL for production
DATABASE_URL=sqlite:///study.db

# Local server settings (used by app.py)
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000
